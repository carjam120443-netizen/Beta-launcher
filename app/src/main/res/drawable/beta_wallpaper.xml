<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#101828"
                android:centerColor="#253B5A"
                android:endColor="#080B12" />
        </shape>
    </item>
    <item android:top="-120dp" android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#385CFF" />
        </shape>
    </item>
    <item android:bottom="-180dp" android:left="-120dp">
        <shape android:shape="oval">
            <solid android:color="#7C3AED" />
        </shape>
    </item>
</layer-list>
